[global]
ioengine=windowsaio
direct=1
thread
filename=D\:\ssdbench\fio_test.dat
size=64g
time_based
runtime=120
ramp_time=0
group_reporting
norandommap
randrepeat=0
refill_buffers
percentile_list=50:95:99:99.9:99.99
cpus_allowed=2,4,6,8,10,12,14,16
cpus_allowed_policy=split
iodepth=8
numjobs=4
rw=randwrite
write_iops_log=data/raw/state/randwrite
bs=4k
log_avg_msec=1000
write_lat_log=data/raw/state/randwrite

[randwrite_4k_4x8_long]
